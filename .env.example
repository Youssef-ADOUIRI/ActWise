# Copy to .env (git-ignored) and fill in.
PROFILE=local                # local | cloud

# LLM providers, tried in this order
LLM_PROVIDER_ORDER=gemini,groq,ollama
GEMINI_API_KEY=
GEMINI_MODEL=                # a model listed as free on the Gemini pricing page
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_MODEL=qwen3:4b
ANTHROPIC_API_KEY=           # optional, only with credits
ANTHROPIC_MODEL=

# Vector store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Integrations
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
GSHEETS_SA_JSON=
REGISTER_NAME=ActWise register

# API guards
ACTWISE_API_KEY=             # empty = public demo
MAX_DAILY_REQUESTS=200
