# Copy to .env (git-ignored) and fill in.
PROFILE=local                # local | cloud

# LLM providers, tried in this order; one with an empty key or model is skipped
LLM_PROVIDER_ORDER=gemini,groq,ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite  # free on the Gemini pricing page; 2.5 Flash-Lite is closed to new users
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_MODEL=qwen3:4b
ANTHROPIC_API_KEY=           # optional, only with credits
ANTHROPIC_MODEL=

# LLM judge for faithfulness: another model family than the one that answers
JUDGE_PROVIDER=groq
JUDGE_MODEL=openai/gpt-oss-120b

# Vector store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Tracing (step 12, decision 012): off unless LANGSMITH_TRACING=true
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=actwise
# An EU account uses https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Integrations (setup: docs/integrations.md)
SLACK_BOT_TOKEN=             # xoxb-...
SLACK_APP_TOKEN=             # xapp-..., scope connections:write
# The register is on when GSHEETS_SA_JSON is set: the service account's JSON key on one
# line, in single quotes
GSHEETS_SA_JSON=
GSHEETS_REGISTER_ID=         # the sheet's id, between /d/ and /edit in its URL
REGISTER_KEY=                # HMAC key for the description hashes: secrets.token_hex(32)

# API guards
ACTWISE_API_KEY=             # empty = public demo
MAX_DAILY_REQUESTS=200       # requests that reach a model, per instance and per day

# UI (make ui)
ACTWISE_API_URL=http://localhost:8000
